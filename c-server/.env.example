# C-Server Configuration

# HTTP Server Port
C_SERVER_PORT=8080

# Blockchain RPC Configuration
# For mainnet: https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# For Sepolia testnet: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/demo

# Token Contracts (ERC20 - these are on Ethereum, update for testnet)
# Mainnet USDT: 0xdac17f958d2ee523a2206206994597c13d831ec7
# Testnet USDT: 0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0 (Sepolia)
USDT_CONTRACT=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# Mainnet USDC: 0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
# Testnet USDC: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238 (Sepolia)
USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Custody Wallet Address (where you want to receive deposits)
# Example: 0x742d35Cc6634C0532925a3b844Bc0e7595f58bF
CUSTODY_WALLET=0x742d35Cc6634C0532925a3b844Bc0e7595f58bF

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_EXCHANGE=gtel-events
RABBITMQ_ROUTING_KEY=ledger.crypto
