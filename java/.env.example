# Copy to .env and adjust. Used by ./dev-server.sh and ./dev-java.sh migrate|start|all.
# Same keys can be set in src/main/resources/application.properties (env and -D override file).
#
# Local example (create DB first: createdb nivic):
JDBC_URL=jdbc:postgresql://127.0.0.1:5432/nivic?sslmode=disable
JDBC_USER=merchants
JDBC_PASSWORD=merchants123
# JDBC_POOL_SIZE=10
