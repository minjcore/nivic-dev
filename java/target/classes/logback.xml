<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Logback configuration for GtelPay application -->
  <!-- Level hierarchy: TRACE < DEBUG < INFO < WARN < ERROR -->

  <!-- Properties -->
  <property name="LOG_DIR" value="${user.home}/logs/nivic"/>
  <property name="LOG_FILE" value="${LOG_DIR}/application.log"/>
  <property name="AUDIT_FILE" value="${LOG_DIR}/audit.log"/>
  <property name="ERROR_FILE" value="${LOG_DIR}/error.log"/>

  <!-- Console Appender -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Application Log File -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- Audit Log (COA transactions) -->
  <appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${AUDIT_FILE}</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/audit-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>500MB</maxFileSize>
      <maxHistory>90</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- Error Log -->
  <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${ERROR_FILE}</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %logger{36} - %msg%n%ex{full}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <!-- Async Appender for better performance -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="FILE"/>
  </appender>

  <!-- Loggers -->

  <!-- COA/Accounting logger (audit trail) -->
  <logger name="dev.nivic.coa" level="DEBUG">
    <appender-ref ref="AUDIT"/>
  </logger>

  <!-- Database queries (debug mode only) -->
  <logger name="dev.nivic.db" level="INFO"/>

  <!-- Payment/Transaction logger -->
  <logger name="dev.nivic.payment" level="DEBUG"/>

  <!-- Savings logger -->
  <logger name="dev.nivic.saving" level="DEBUG"/>

  <!-- Security logger -->
  <logger name="dev.nivic.security" level="INFO"/>

  <!-- Third-party libraries -->
  <logger name="org.postgresql" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="INFO"/>
  <logger name="io.undertow" level="INFO"/>
  <logger name="com.lmax.disruptor" level="WARN"/>

  <!-- Root Logger -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_FILE"/>
    <appender-ref ref="ERROR"/>
  </root>

  <!-- Development profile -->
  <springProfile name="dev,local">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
      <appender-ref ref="ERROR"/>
    </root>
  </springProfile>

  <!-- Production profile -->
  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ERROR"/>
    </root>
  </springProfile>
</configuration>
